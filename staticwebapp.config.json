{
  "routes": [
    { "route": "/tools/*", "statusCode": 404 },
    { "route": "/tests/*", "statusCode": 404 },
    { "route": "/.github/*", "statusCode": 404 },
    { "route": "/.claude/*", "statusCode": 404 },
    { "route": "/.mcp.json", "statusCode": 404 },
    { "route": "/confirm-bp-findings.js", "statusCode": 404 },
    { "route": "/*.{md,markdown,sh,mjs}", "statusCode": 404 }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/robots.txt","/*.txt","/*.json","/*.ps1","/user-guide.html","/Veeam_Advisor_v*.html"]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "SAMEORIGIN",
    "X-Robots-Tag": "noindex, nofollow, nosnippet, noarchive",
    "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'none'"
  },
  "mimeTypes": { ".html": "text/html", ".txt": "text/plain", ".json": "application/json", ".ps1": "text/plain" }
}
